# Never commit a real config or a credential. config.example is the shipped
# template and must stay tracked, so this matches only a real config dropped
# next to it.
/config/config
*.token

# makepkg output. Anchored to the repository root, so a future source tree
# named src/ somewhere below is not swallowed with it.
/pkg/
/src/
*.pkg.tar.zst
*.pkg.tar.zst.sig

# Release tarballs. The PKGBUILD downloads one from the GitHub tag and makepkg
# leaves it here. A tracked tarball ends up inside the next tarball GitHub
# makes, so every release would carry a copy of the one before it.
*.tar.gz
*.tar.gz.sig

*.bak
*.orig
probe.json

# omarchy-typewriter settings.
#
# Shell syntax, sourced by the tool. Three layers, highest wins:
#   1. TYPEWRITER_* in the environment
#   2. ~/.config/omarchy-typewriter/config   (this file)
#   3. /etc/omarchy-typewriter/config        (system defaults)
#
# Run `omarchy-typewriter-setup` to fill this in interactively.

# Which backend to use: auto | local | ollama | pi | cloudflare | anthropic
# "local" and "ollama" are two names for the same backend.
# auto order: local (if the model is pulled) -> pi -> cloudflare -> anthropic
TYPEWRITER_BACKEND=auto

# --- Local, fully offline ----------------------------------------------------
# Needs ollama, and ollama-vulkan plus OLLAMA_IGPU_ENABLE=1 on the service to
# use an integrated GPU. Without that variable ollama silently runs on the CPU
# at roughly half the speed, and nothing tells you.
#
# Measured on an Intel Arc B390 iGPU, median of 3, on a 327-character paragraph:
#   granite4:micro-h     4.88s   5/5 correctness   1.9 GB
#   qwen3:4b-instruct    4.72s   5/5               2.5 GB
#   llama3.2:3b          3.40s   3/5               2.0 GB
# llama3.2:3b is the fastest and answers short selections instead of rewriting
# them: asked to rewrite "is this working?" it replies "No".
TYPEWRITER_OLLAMA_MODEL=granite4:micro-h
TYPEWRITER_OLLAMA_URL=http://localhost:11434

# --- Cloudflare Workers AI ---------------------------------------------------
# Needs an account id and a token with Account > Workers AI > Read. The token
# lives in its own 0600 file, never here.
#
#   llama-4-scout-17b-16e-instruct   1.48s   8/8 on the hard suite
#   llama-3.3-70b-instruct-fp8-fast  1.13s   7/8, and it changed a word's meaning
#   granite-4.0-h-micro              2.33s   5/5, nine times cheaper
TYPEWRITER_CF_ACCOUNT=
TYPEWRITER_CF_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct
#TYPEWRITER_CF_TOKEN_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-typewriter/cloudflare.token"

# --- pi (agent CLI) ----------------------------------------------------------
# Uses whatever providers you already authenticated in pi, so it needs no token
# of its own. Pin a model: pi's default provider took 15.5s on a paragraph that
# claude-haiku-4-5 did in 1.5s. See `pi --list-models`.
# The tool always runs pi with --no-tools and --no-session. pi ships read, bash,
# edit and write tools, and this feeds it text you did not write.
TYPEWRITER_PI_MODEL=

# --- Anthropic ---------------------------------------------------------------
# Uses ANTHROPIC_API_KEY from the environment.
TYPEWRITER_ANTHROPIC_MODEL=claude-haiku-4-5

# --- Behaviour ---------------------------------------------------------------

# What to act on when you press the key.
#   auto       a selection if you made one, otherwise everything before the
#              cursor in the focused input
#   selection  only ever what is highlighted
#   line       always the line before the cursor
#   words:3    always the last three words
#   all        everything before the cursor
TYPEWRITER_SCOPE=auto

# What auto falls back to when nothing is selected.
#   all   everything before the cursor in the focused input. Ctrl+Shift+Home
#         stops at the input boundary, so a Gmail compose box or a Slack message
#         is taken whole without the quoted thread below it.
#   line  only back to the start of the current line. Safer in a code editor,
#         where "all" means everything above the cursor.
TYPEWRITER_AUTO_FALLBACK=all

# How long to wait for the app to put the selection on the clipboard. Raise it
# if a slow Electron app reports "nothing selected" for text that was selected.
TYPEWRITER_CAPTURE_TIMEOUT_MS=640

# Seconds to wait for you to release the hotkey before typing anything.
TYPEWRITER_PASTE_DELAY=0.3

# If the result is under this percentage of the input length, do not paste it.
# Catches a model answering the selection instead of rewriting it. Only applies
# to inputs longer than 80 characters.
TYPEWRITER_MIN_RATIO=20

# Refuse selections longer than this, as a guard against a stale selection.
TYPEWRITER_MAX_CHARS=20000

# Show the on-screen indicator while working. 1 or 0.
# On Omarchy this is the shell's bottom-centre OSD; elsewhere hyprctl notify.
TYPEWRITER_INDICATOR=1

# Desktop notification on failure. 1 or 0. On Omarchy the failure already shows
# in the bottom-centre pill, so this only applies elsewhere.
TYPEWRITER_NOTIFY=1

# Terms to protect and replacements to enforce. See the Wordlist section of the
# README. One rule per line: a bare word is protected, "x => y" is a rule.
#TYPEWRITER_WORDLIST="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-typewriter/wordlist"

# How many writing samples to send from a preset's <preset>.samples/ directory.
#TYPEWRITER_MAX_SAMPLES=5

# How many runs to keep in the history used by `omarchy-typewriter stats`.
# Metadata only - counts and timings, never the text you refined.
#TYPEWRITER_HISTORY_MAX=500

# Where presets are read from before /usr/share and the checkout.
#TYPEWRITER_PROMPT_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy-typewriter/prompts"

# Seconds before omarchy-typewriter-status ages a non-idle state back to idle,
# so a stale failure cannot sit in your bar.
#TYPEWRITER_STATUS_STALE_AFTER=120

# Force terminal key bindings (Ctrl+Shift+C/V) on or off, for compositors where
# the window class cannot be read. 1, 0, or unset to detect.
#TYPEWRITER_TERMINAL=

# Seconds to allow a single wl-paste before giving up on it.
#TYPEWRITER_PASTE_TIMEOUT=3

# Restore whatever was on the clipboard before the run. 1 or 0.
TYPEWRITER_RESTORE_CLIPBOARD=1

# Window classes treated as terminals, which need Ctrl+Shift+C and Ctrl+Shift+V.
# An unlisted terminal gets a bare Ctrl+C, which is SIGINT rather than a copy.
# Anchored, so it matches a whole class name - an unanchored pattern once
# matched "Serious-Sam" via "rio".
#
# Setting this REPLACES the built-in list rather than adding to it, so start
# from the default below and extend it. Dropping a terminal you actually use is
# how you get the bare Ctrl+C this comment warns about: ghostty reports the
# class com.mitchellh.ghostty, and footclient is not foot. This is the built-in
# default, copied from bin/omarchy-typewriter.
#TYPEWRITER_TERMINAL_RE='^(alacritty|foot(client)?|kitty|com\.mitchellh\.ghostty|ghostty|wezterm|org\.wezfurlong\..*|rio|contour|konsole|org\.kde\.konsole|xterm|urxvt|rxvt.*|st|stterm|terminator|tilix|dev\.warp\.Warp|terminology|eterm|org\.gnome\.(Terminal|Console)|.*[-.]terminal)$'
